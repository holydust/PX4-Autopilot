#!/bin/sh
#
# @name Gazebo x500
#
# @type Quadrotor
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.13
param set-default CA_ROTOR0_PY 0.22
param set-default CA_ROTOR0_KM  0.05

param set-default CA_ROTOR1_PX -0.13
param set-default CA_ROTOR1_PY -0.20
param set-default CA_ROTOR1_KM  0.05

param set-default CA_ROTOR2_PX 0.13
param set-default CA_ROTOR2_PY -0.22
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.13
param set-default CA_ROTOR3_PY 0.20
param set-default CA_ROTOR3_KM -0.05

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000

param set-default MPC_THR_HOVER 0.60

# ============================================================================
# Throw-to-launch demo (corvon dev-test, 2026-04-25)
# ============================================================================
# Feature: motors stay off after arm; once velocity exceeds COM_THROW_SPEED
# (default 5 m/s) and vz>0 (falling), commander transitions through
# MulticopterThrowLaunch state machine ARMED -> UNSAFE -> FLYING and
# starts motors with position controller taking over.
#
# COM_THROW_EN=1 enables the feature.
# COM_THROW_SPEED=5 (default, kept) is the throw detection threshold.
param set-default COM_THROW_EN 1

# ----------------------------------------------------------------------------
# SITL throw demo bypasses
# ----------------------------------------------------------------------------
# Without these, arm-in-AUTO.LOITER immediately failsafe-disarms because
# SITL has no real RC / GCS / ESC telemetry. Each line below disables one
# specific check; see deployment doc for full debug trail.
#
# NAV_DLL_ACT=0  : disable GCS-loss failsafe action (no QGC connected)
# NAV_RCL_ACT=0  : disable RC-loss failsafe action (no RC)
# COM_RC_IN_MODE=4: declare RC stick input not required for arming
# FD_ESCS_EN=0   : disable failure_detector ESC arming check
#                  (without this, fd_esc_arming_failure flips true once
#                  during spoolup window and triggers immediate Disarm)
# COM_ARM_CHK_ESCS=0: skip pre-arm ESC count check
# CBRK_SUPPLY_CHK=894281: bypass power supply unhealthy check
param set-default NAV_DLL_ACT 0
param set-default NAV_RCL_ACT 0
param set-default COM_RC_IN_MODE 4
param set-default FD_ESCS_EN 0
param set-default COM_ARM_CHK_ESCS 0
param set-default CBRK_SUPPLY_CHK 894281
